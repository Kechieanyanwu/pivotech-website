# Leave unset until a Pivotech-owned Sanity project exists. The website keeps working.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Server-only Viewer token for authenticated draft previews. Never use NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server-only secret matching the signed publishing webhook.
SANITY_REVALIDATE_SECRET=
# Studio uses the same project/dataset. Only public configuration has this prefix.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_PREVIEW_URL=http://localhost:3001
