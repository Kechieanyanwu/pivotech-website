# Leave unset until a Pivotech-owned Sanity project exists. The website keeps working.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Server-only Viewer token for authenticated draft previews. Never use NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server-only secret matching the signed publishing webhook.
SANITY_REVALIDATE_SECRET=
# Studio uses the same project/dataset. Only public configuration has this prefix.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Private member directory. Set these in local .env.local and the deployment host.
MEMBERS_ADMIN_PASSWORD=
# Use a random secret of at least 32 characters.
MEMBERS_SESSION_SECRET=
# Server-only Google service account access. Share the spreadsheet with this account as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=1vNGxDZc6RAsS7pywyBn7Sn68CkYsxvJqJc8kQg9pm9E
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# Paste the private key; preserve line breaks as literal \n when storing in hosting settings.
GOOGLE_SHEETS_PRIVATE_KEY=
# Speaker submission responses. Share this Sheet with the same service account as Viewer.
GOOGLE_TALKS_SPREADSHEET_ID=1ipZzCLRP7s3ED8J0LTwHtyJ0qGk72pr5ij5jaaFM4yQ
